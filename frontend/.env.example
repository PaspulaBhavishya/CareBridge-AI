# CareBridge AI Frontend - Firebase Realtime Database Configuration
# Copy this file to .env and fill in your Firebase project values.
# You can also configure Firebase directly in the Settings view in the app!

VITE_FIREBASE_API_KEY=AIzaSyYourApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=carebridge-ai-demo.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://carebridge-ai-demo-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=carebridge-ai-demo
VITE_FIREBASE_STORAGE_BUCKET=carebridge-ai-demo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
