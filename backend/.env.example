# CareBridge AI Backend - Firebase Realtime Database Configuration
# Copy this file to .env and configure your Firebase Realtime Database URL:
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# Optional: Firebase Auth Secret or Database Secret (for locked/private rules)
# Leave blank if using default open development test rules
FIREBASE_AUTH_SECRET=your-firebase-auth-secret-here
